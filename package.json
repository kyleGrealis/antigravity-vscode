{
	"name": "positronium",
	"displayName": "Positronium",
	"description": "Positronium: Antigravity AI pair programmer for Positron & VS Code",
	"version": "0.2.5",
	"publisher": "kylegrealis",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/kyleGrealis/positronium.git"
	},
	"icon": "media/antigravity-icon.png",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"AI",
		"Chat"
	],
	"keywords": [
		"positronium",
		"positron",
		"orbit",
		"antigravity",
		"agy",
		"ai",
		"agent",
		"gemini"
	],
	"activationEvents": [
		"onStartupFinished",
		"onWebviewPanel:positroniumPanel"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"configuration": {
			"title": "Positronium (Antigravity)",
			"properties": {
				"antigravity.cliPath": {
					"type": "string",
					"default": "agy",
					"description": "Path or executable name for the Antigravity CLI binary."
				},
				"antigravity.dangerouslySkipPermissions": {
					"type": "boolean",
					"default": false,
					"description": "Auto-approve all tool permission requests without prompting. When disabled (recommended), Antigravity will prompt for permission before executing tools."
				},
				"antigravity.bypassSandbox": {
					"type": "boolean",
					"default": false,
					"description": "Bypass sandbox container isolation for tool command executions."
				},
				"antigravity.model": {
					"type": "string",
					"default": "gemini-3.7-flash-high",
					"enum": [
						"gemini-3.7-flash-high",
						"gemini-3.7-flash-medium",
						"gemini-3.7-flash-low",
						"gemini-3.6-flash-high",
						"gemini-3.6-flash-medium",
						"gemini-3.6-flash-low",
						"gemini-3.5-flash-high",
						"gemini-3.5-flash-medium",
						"gemini-3.5-flash-low",
						"gemini-3.1-pro-high",
						"gemini-3.1-pro-low",
						"claude-sonnet-4-6",
						"claude-opus-4-6-thinking",
						"gpt-oss-120b-medium"
					],
					"enumDescriptions": [
						"Gemini 3.7 Flash (High reasoning effort)",
						"Gemini 3.7 Flash (Medium reasoning effort)",
						"Gemini 3.7 Flash (Low reasoning effort)",
						"Gemini 3.6 Flash (High reasoning effort)",
						"Gemini 3.6 Flash (Medium reasoning effort)",
						"Gemini 3.6 Flash (Low reasoning effort)",
						"Gemini 3.5 Flash (High reasoning effort)",
						"Gemini 3.5 Flash (Medium reasoning effort)",
						"Gemini 3.5 Flash (Low reasoning effort)",
						"Gemini 3.1 Pro (High reasoning effort)",
						"Gemini 3.1 Pro (Low reasoning effort)",
						"Claude Sonnet 4.6 (Thinking)",
						"Claude Opus 4.6 (Thinking)",
						"GPT-OSS 120B (Medium reasoning effort)"
					],
					"description": "Active AI model used for Antigravity sessions."
				},
				"antigravity.effort": {
					"type": "string",
					"default": "medium",
					"enum": [
						"low",
						"medium",
						"high"
					],
					"enumDescriptions": [
						"Low reasoning effort for rapid, concise responses",
						"Medium reasoning effort (balanced for coding and tool execution)",
						"High reasoning effort for deep architectural analysis and multi-step tasks"
					],
					"description": "Default reasoning effort level for Antigravity sessions."
				}
			}
		},
		"commands": [
			{
				"command": "positronium.editor.open",
				"title": "Positronium: Open in New Tab",
				"icon": "$(layout-sidebar-right-off)"
			},
			{
				"command": "positronium.sidebar.open",
				"title": "Positronium: Open in Side Bar",
				"icon": "$(layout-sidebar-right)"
			},
			{
				"command": "positronium.newConversation",
				"title": "Positronium: New Conversation",
				"icon": "$(add)"
			},
			{
				"command": "positronium.acceptProposedDiff",
				"title": "Positronium: Accept Proposed Changes",
				"enablement": "positronium.viewingProposedDiff",
				"icon": "$(check)"
			},
			{
				"command": "positronium.rejectProposedDiff",
				"title": "Positronium: Reject Proposed Changes",
				"enablement": "positronium.viewingProposedDiff",
				"icon": "$(discard)"
			},
			{
				"command": "positronium.focus",
				"title": "Positronium: Focus Input",
				"icon": "$(keyboard)"
			}
		],
		"keybindings": [
			{
				"command": "positronium.focus",
				"key": "ctrl+escape",
				"mac": "cmd+escape",
				"win": "ctrl+escape",
				"linux": "ctrl+escape"
			},
			{
				"command": "positronium.editor.open",
				"key": "ctrl+shift+escape",
				"mac": "cmd+shift+escape",
				"win": "ctrl+shift+escape",
				"linux": "ctrl+shift+escape"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "positronium-sidebar-container",
					"title": "POSITRONIUM",
					"icon": "media/antigravity-icon.svg"
				}
			]
		},
		"views": {
			"positronium-sidebar-container": [
				{
					"type": "webview",
					"id": "positroniumSidebar",
					"name": "POSITRONIUM",
					"icon": "media/antigravity-icon.svg"
				}
			]
		},
		"menus": {
			"editor/title": [
				{
					"command": "positronium.acceptProposedDiff",
					"when": "positronium.viewingProposedDiff",
					"group": "navigation"
				},
				{
					"command": "positronium.rejectProposedDiff",
					"when": "positronium.viewingProposedDiff",
					"group": "navigation"
				},
				{
					"command": "positronium.editor.open",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"build": "tsc --noEmit && node esbuild.js",
		"watch": "node esbuild.js --watch",
		"package": "vsce package"
	},
	"devDependencies": {
		"@types/marked": "^5.0.2",
		"@types/node": "^20.10.0",
		"@types/vscode": "^1.85.0",
		"@vscode/vsce": "^2.22.0",
		"esbuild": "^0.19.8",
		"marked": "^18.0.7",
		"typescript": "^5.3.3"
	},
	"dependencies": {
		"mermaid": "^11.16.0"
	}
}
